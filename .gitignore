.idea/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Прогони ГА версіонуються всі (§11): config.json, metrics.csv, timing.csv і
# best_genome.json важать десятки КБ, а побітово відтворити прогін можна лише в
# тому самому середовищі (R7). Поза git — лише важке й похідне:
#   checkpoints/ — популяція кожні 25 поколінь, потрібна тільки для --resume;
#   figures/     — генерується export-ом із metrics.csv;
#   *.tmp        — проміжні файли атомарного запису (tmp + os.replace).
experiments/runs/*/checkpoints/
experiments/runs/*/figures/
experiments/runs/**/*.tmp

# Бібліотеки сутностей (creatures/, predators/, presets/) НЕ ігноруються:
# це створені руками істоти, хижаки та сцени, і вони мусять переживати
# видалення воркспейсу — єдиний спосіб цього досягти — тримати їх у git.
# Ігноруємо лише службове:
#   last_session.json — чернетка редактора, яку автозбереження перезаписує на
#                       кожну правку (у git давало б постійний шум у diff);
#   .tmp-*            — проміжні файли атомарного запису (tmp + os.replace).
experiments/editor/last_session.json
experiments/editor/**/.tmp-*
