.idea/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Робочі прогони ГА — лише локально: сюди пишуть усі старти, зокрема пробні
# й зупинені вручну.
experiments/runs/*
!experiments/runs/.gitkeep

# Архів (§11): прогін, що пройшов усі заплановані покоління без помилки,
# копіюється сюди автоматично — і версіонується, бо побітово відтворити його
# можна лише в тому самому середовищі (R7). Чекпоінтів і графіків в архіві
# немає; на випадок ручного копіювання вони теж ігноруються.
experiments/archive/*/checkpoints/
experiments/archive/*/figures/
experiments/archive/**/*.tmp

# Бібліотеки сутностей (creatures/, predators/, presets/) НЕ ігноруються:
# це створені руками істоти, хижаки та сцени, і вони мусять переживати
# видалення воркспейсу — єдиний спосіб цього досягти — тримати їх у git.
# Ігноруємо лише службове:
#   last_session.json — чернетка редактора, яку автозбереження перезаписує на
#                       кожну правку (у git давало б постійний шум у diff);
#   .tmp-*            — проміжні файли атомарного запису (tmp + os.replace).
experiments/editor/last_session.json
experiments/editor/**/.tmp-*
